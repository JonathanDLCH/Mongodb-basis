use("sample_training")

//Get info for subDocument
db.trips.find({
    "start station location.type": "Point"
})


db.companies.find({
    "relationships.0.person.last_name": "Zuckerberg"
},{
    name: 1,
    relationships: 1
})

db.companies.find({
    "relationships.0.person.first_name": "Mark"
},{
    name: 1,
    relationships: 1
})
.count()

// any element in array
db.companies.find({
    "relationships":{
        $elemMatch: {
            "person.first_name": "Mark"
        }
    }
},{
    name: 1,
    relationships: 1
})
.count()