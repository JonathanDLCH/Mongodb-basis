use("sample_training")

db.trips.find({
    $expr: {
        $eq: ["$star station id","$end station id"]
    }
})
.count()

db.trips.find({
    $expr: {
        $and: [
            { $eq: ["$star station id","$end station id"] },
            { $gte: ["$tripduration",1200] }
            
        ]
    }
})