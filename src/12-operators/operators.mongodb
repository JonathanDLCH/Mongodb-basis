use("store")

// Using $gt (>) and $gte (>=)
db.inventory.find({
    qty: { $gt: 20}
}) 

db.inventory.find({
    qty: { $gte: 20}
}) 

// Using $lt (>) and $lte (>=)
db.inventory.find({
    qty: { $lt: 20}
})

db.inventory.find({
    qty: { $lte: 20}
})

//join
db.inventory.find({ 
    qty: {
        $gte:25,
        $lte:35
    }
})

db.inventory.find({ 
    qty: {
        $gte:10,
        $lte:35
    },
    "item.name": "ab"
})